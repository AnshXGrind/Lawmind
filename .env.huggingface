# Hugging Face Space Environment Variables
# ==========================================
# Add these in your HF Space Settings → Variables and secrets
# Do NOT commit this file with real values!

# ---- REQUIRED ----

# Your Gemini API key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production

# ---- OPTIONAL ----

# Database URL — SQLite default works fine on HF (resets on restart)
DATABASE_URL=sqlite:///./lawmind.db

# CORS allowed origins — JSON array of your frontend URL(s)
CORS_ORIGINS=["https://your-vercel-app.vercel.app","http://localhost:3000"]

# Explicit frontend URL (alternative to CORS_ORIGINS)
FRONTEND_URL=https://your-vercel-app.vercel.app

# Debug mode (set to False in production)
DEBUG=False

# Port (Hugging Face requires 7860 — do not change unless you update Dockerfile too)
PORT=7860
