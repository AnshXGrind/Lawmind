# Application Settings
APP_NAME=LawMind
VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./lawmind.db
# For PostgreSQL: postgresql://user:password@localhost/lawmind_db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# AI/LLM Configuration — Free Gemini API
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Settings
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# Vector DB (ChromaDB — local, no external service needed)
VECTOR_DB_PATH=./chroma_db

# Vector Database
VECTOR_DB_PATH=./data/vectordb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
EXPORT_DIR=./exports

# Voice Processing
WHISPER_MODEL=base
AUDIO_MAX_SIZE=26214400
